{
  "name": "mxrf11-numero-magico",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MXRF11 · O Número Mágico — Financial Intelligence Simulator 2.0",
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:live": "tsx scripts/check-live.ts",
    "start": "npm run build && tsx server/index.ts",
    "lint": "eslint .",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "data:update": "tsx scripts/update-data.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "fflate": "^0.8.3",
    "lucide-react": "0.460.0",
    "node-cron": "^4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.1",
    "undici": "^6.29.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "6.0.7",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
