{
  "name": "mxrf11-numero-magico",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MXRF11 · O Número Mágico — Financial Intelligence Simulator 2.0",
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.460.0",
    "node-cron": "3.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "@types/node-cron": "3.0.11",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "^3.0.5"
  }
}
